@page
@model TwoFactorAuthenticationModel

@{
    ViewData["Title"] = "Autenticación en dos pasos";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<div class="section-card">
    <h2 class="h4 mb-2">Autenticación en dos pasos</h2>
    <p class="text-muted mb-4">
        Configura opciones adicionales de seguridad para proteger tu cuenta.
    </p>

    <partial name="_StatusMessage" for="StatusMessage" />

    @if (Model.Is2faEnabled)
    {
        <div class="alert alert-success">
            La autenticación en dos pasos está activa para esta cuenta.
        </div>
    }
    else
    {
        <div class="alert alert-info">
            La autenticación en dos pasos aún no está activa para esta cuenta.
        </div>
    }

    <div class="d-flex flex-wrap gap-2 mt-3">
        <a asp-page="./EnableAuthenticator" class="btn btn-primary">
            Configurar autenticador
        </a>

        @if (Model.Is2faEnabled)
        {
            <a asp-page="./Disable2fa" class="btn btn-outline-secondary">
                Desactivar autenticación
            </a>
        }

        <a asp-page="./GenerateRecoveryCodes" class="btn btn-outline-primary">
            Generar códigos de recuperación
        </a>
    </div>
</div>
