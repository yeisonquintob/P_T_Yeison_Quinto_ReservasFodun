@model ReservasFodun.Application.DTOs.Alojamientos.SedeDto

@{
    ViewData["Title"] = "Detalle de sede";
}

<div class="container py-4">
    <a class="btn btn-link px-0 mb-3" asp-action="Index">? Volver a sedes</a>

    <div class="card shadow-sm">
        <div class="card-body">
            <h2>@Model.NombreSede</h2>
            <p class="text-muted">@Model.NombreCorto</p>

            <hr />

            <p><strong>Tipo de sede:</strong> @Model.TipoSede</p>
            <p><strong>Municipio:</strong> @Model.Municipio</p>
            <p><strong>Departamento:</strong> @Model.Departamento</p>
            <p><strong>Dirección:</strong> @Model.Direccion</p>
            <p><strong>Capacidad total:</strong> @Model.CapacidadTotal personas</p>

            <p class="mt-3">@Model.Descripcion</p>

            <a class="btn btn-primary" asp-controller="Disponibilidad" asp-action="Index">
                Consultar disponibilidad
            </a>
        </div>
    </div>
</div>
