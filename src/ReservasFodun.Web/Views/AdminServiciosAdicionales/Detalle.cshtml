@model ReservasFodun.Application.DTOs.Admin.ServicioAdicionalAdminDto

@{
    ViewData["Title"] = "Detalle servicio adicional";
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
    <div>
        <h1 class="page-title">@Model.Nombre</h1>
        <p class="page-subtitle">Detalle administrativo del servicio adicional.</p>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Editar" asp-route-id="@Model.IdServicioAdicional" class="btn btn-primary">Editar</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
    </div>
</div>

<div class="section-card">
    <dl class="row mb-0">
        <dt class="col-sm-4">Código</dt>
        <dd class="col-sm-8">@Model.IdServicioAdicional</dd>

        <dt class="col-sm-4">Nombre</dt>
        <dd class="col-sm-8">@Model.Nombre</dd>

        <dt class="col-sm-4">Descripción</dt>
        <dd class="col-sm-8">@(Model.Descripcion ?? "No registrada")</dd>

        <dt class="col-sm-4">Valor</dt>
        <dd class="col-sm-8">@Model.Valor.ToString("C0")</dd>

        <dt class="col-sm-4">Por persona</dt>
        <dd class="col-sm-8">@(Model.PorPersona ? "Sí" : "No")</dd>

        <dt class="col-sm-4">Por noche</dt>
        <dd class="col-sm-8">@(Model.PorNoche ? "Sí" : "No")</dd>

        <dt class="col-sm-4">Estado</dt>
        <dd class="col-sm-8">
            @if (Model.Activo)
            {
                <span class="badge bg-dark">Activo</span>
            }
            else
            {
                <span class="badge bg-secondary">Inactivo</span>
            }
        </dd>
    </dl>
</div>
