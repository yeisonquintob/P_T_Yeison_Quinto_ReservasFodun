@model IEnumerable<ReservasFodun.Application.DTOs.Admin.ServicioAdicionalAdminDto>

@{
    ViewData["Title"] = "Servicios adicionales";
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
    <div>
        <h1 class="page-title">Servicios adicionales</h1>
        <p class="page-subtitle">Administra servicios adicionales que pueden asociarse a una reserva.</p>
    </div>

    <a asp-action="Crear" class="btn btn-primary">Crear servicio</a>
</div>

@if (Model is null || !Model.Any())
{
    <div class="alert alert-info">No hay servicios adicionales registrados.</div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Nombre</th>
                    <th>Valor</th>
                    <th>Cobro</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var servicio in Model)
                {
                    <tr>
                        <td>@servicio.IdServicioAdicional</td>
                        <td>
                            <strong>@servicio.Nombre</strong>
                            <div class="text-muted small">@(servicio.Descripcion ?? "Sin descripción")</div>
                        </td>
                        <td>@servicio.Valor.ToString("C0")</td>
                        <td>
                            @if (servicio.PorPersona)
                            {
                                <span class="badge bg-dark">Por persona</span>
                            }

                            @if (servicio.PorNoche)
                            {
                                <span class="badge bg-secondary">Por noche</span>
                            }

                            @if (!servicio.PorPersona && !servicio.PorNoche)
                            {
                                <span class="badge bg-light text-dark">Fijo</span>
                            }
                        </td>
                        <td>
                            @if (servicio.Activo)
                            {
                                <span class="badge bg-dark">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactivo</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-2">
                                <a asp-action="Detalle" asp-route-id="@servicio.IdServicioAdicional" class="btn btn-outline-primary btn-sm">Ver</a>
                                <a asp-action="Editar" asp-route-id="@servicio.IdServicioAdicional" class="btn btn-primary btn-sm">Editar</a>

                                @if (servicio.Activo)
                                {
                                    <form asp-action="Inactivar" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@servicio.IdServicioAdicional" />
                                        <button type="submit" class="btn btn-outline-secondary btn-sm"
                                                onclick="return confirm('¿Seguro que deseas inactivar este servicio adicional?');">
                                            Inactivar
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="Activar" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@servicio.IdServicioAdicional" />
                                        <button type="submit" class="btn btn-outline-primary btn-sm"
                                                onclick="return confirm('¿Seguro que deseas activar este servicio adicional?');">
                                            Activar
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
