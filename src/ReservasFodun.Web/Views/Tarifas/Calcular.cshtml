@model ReservasFodun.Application.DTOs.Tarifas.CalcularValorReservaRequest

@{
    ViewData["Title"] = "Calcular valor de reserva";
    var sedes = ViewBag.Sedes as IEnumerable<ReservasFodun.Application.DTOs.Alojamientos.SedeDto>
        ?? Enumerable.Empty<ReservasFodun.Application.DTOs.Alojamientos.SedeDto>();
}

<div class="container py-4">
    <h2>Calcular valor de reserva</h2>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Calcular" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label class="form-label">Sede</label>
                    <select class="form-select" asp-for="IdSede">
                        <option value="">Seleccione una sede</option>
                        @foreach (var sede in sedes)
                        {
                            <option value="@sede.IdSede">@sede.NombreSede</option>
                        }
                    </select>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="IdAlojamiento" class="form-label">Id Alojamiento</label>
                        <input asp-for="IdAlojamiento" class="form-control" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="FechaLlegada" class="form-label">Fecha llegada</label>
                        <input asp-for="FechaLlegada" type="date" class="form-control" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="FechaSalida" class="form-label">Fecha salida</label>
                        <input asp-for="FechaSalida" type="date" class="form-control" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="NumeroPersonas" class="form-label">Personas</label>
                        <input asp-for="NumeroPersonas" class="form-control" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="NumeroHabitaciones" class="form-label">Habitaciones</label>
                        <input asp-for="NumeroHabitaciones" class="form-control" />
                    </div>

                    <div class="col-md-4 mb-3 d-flex align-items-end">
                        <div class="form-check">
                            <input asp-for="IncluirLavanderia" class="form-check-input" />
                            <label asp-for="IncluirLavanderia" class="form-check-label">
                                Incluir lavandería
                            </label>
                        </div>
                    </div>
                </div>

                <button class="btn btn-primary" type="submit">Calcular</button>
            </form>
        </div>
    </div>
</div>
