@model ReservasFodun.Application.DTOs.Admin.TemporadaAdminDto

@{
    ViewData["Title"] = "Detalle temporada";
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
    <div>
        <h1 class="page-title">@Model.Nombre</h1>
        <p class="page-subtitle">Detalle administrativo de la temporada.</p>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Editar" asp-route-id="@Model.IdTemporada" class="btn btn-primary">Editar</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
    </div>
</div>

<div class="section-card">
    <dl class="row mb-0">
        <dt class="col-sm-4">Código</dt>
        <dd class="col-sm-8">@Model.IdTemporada</dd>

        <dt class="col-sm-4">Nombre</dt>
        <dd class="col-sm-8">@Model.Nombre</dd>

        <dt class="col-sm-4">Descripción</dt>
        <dd class="col-sm-8">@(Model.Descripcion ?? "No registrada")</dd>

        <dt class="col-sm-4">Temporada alta</dt>
        <dd class="col-sm-8">@(Model.EsAlta ? "Sí" : "No")</dd>

        <dt class="col-sm-4">Temporada especial</dt>
        <dd class="col-sm-8">@(Model.EsEspecial ? "Sí" : "No")</dd>

        <dt class="col-sm-4">Tarifas asociadas</dt>
        <dd class="col-sm-8">@Model.TotalTarifas</dd>

        <dt class="col-sm-4">Estado</dt>
        <dd class="col-sm-8">
            @if (Model.Activo)
            {
                <span class="badge bg-dark">Activa</span>
            }
            else
            {
                <span class="badge bg-secondary">Inactiva</span>
            }
        </dd>
    </dl>
</div>
