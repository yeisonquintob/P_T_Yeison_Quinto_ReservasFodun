@model ReservasFodun.Application.DTOs.Admin.TemporadaFormularioRequest

@{
    ViewData["Title"] = "Editar temporada";
}

<div class="mb-4">
    <h1 class="page-title">Editar temporada</h1>
    <p class="page-subtitle">Actualiza la información de la temporada seleccionada.</p>
</div>

<div class="section-card">
    <form asp-action="Editar" method="post">
        @Html.AntiForgeryToken()

        <input asp-for="IdTemporada" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <partial name="_FormularioTemporada" model="Model" />

        <div class="d-flex flex-wrap gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Guardar cambios</button>
            <a asp-action="Detalle" asp-route-id="@Model.IdTemporada" class="btn btn-outline-primary">Ver detalle</a>
            <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
