@model ReservasFodun.Application.DTOs.Admin.SedeFormularioRequest

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="NombreSede" class="form-label"></label>
        <input asp-for="NombreSede" class="form-control" />
        <span asp-validation-for="NombreSede" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="NombreCorto" class="form-label"></label>
        <input asp-for="NombreCorto" class="form-control" />
        <span asp-validation-for="NombreCorto" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="IdTipoSede" class="form-label"></label>
        <select asp-for="IdTipoSede" asp-items="ViewBag.TiposSede" class="form-select">
            <option value="">Seleccione...</option>
        </select>
        <span asp-validation-for="IdTipoSede" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="IdMunicipio" class="form-label"></label>
        <select asp-for="IdMunicipio" asp-items="ViewBag.Municipios" class="form-select">
            <option value="">Seleccione...</option>
        </select>
        <span asp-validation-for="IdMunicipio" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="CapacidadTotal" class="form-label"></label>
        <input asp-for="CapacidadTotal" class="form-control" type="number" min="1" />
        <span asp-validation-for="CapacidadTotal" class="text-danger"></span>
    </div>

    <div class="col-md-6 d-flex align-items-end">
        <div class="form-check mb-2">
            <input asp-for="Activo" class="form-check-input" />
            <label asp-for="Activo" class="form-check-label"></label>
        </div>
    </div>

    <div class="col-md-12">
        <label asp-for="Direccion" class="form-label"></label>
        <input asp-for="Direccion" class="form-control" />
        <span asp-validation-for="Direccion" class="text-danger"></span>
    </div>

    <div class="col-md-12">
        <label asp-for="Descripcion" class="form-label"></label>
        <textarea asp-for="Descripcion" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Descripcion" class="text-danger"></span>
    </div>
</div>
