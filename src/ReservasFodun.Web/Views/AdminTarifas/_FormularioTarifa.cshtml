@model ReservasFodun.Application.DTOs.Admin.TarifaFormularioRequest

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="IdSede" class="form-label"></label>
        <select asp-for="IdSede" asp-items="ViewBag.Sedes" class="form-select">
            <option value="">Todas las sedes recreativas / No aplica</option>
        </select>
        <span asp-validation-for="IdSede" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="IdAlojamiento" class="form-label"></label>
        <select asp-for="IdAlojamiento" asp-items="ViewBag.Alojamientos" class="form-select">
            <option value="">No aplica</option>
        </select>
        <span asp-validation-for="IdAlojamiento" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="IdTemporada" class="form-label"></label>
        <select asp-for="IdTemporada" asp-items="ViewBag.Temporadas" class="form-select">
            <option value="">Seleccione...</option>
        </select>
        <span asp-validation-for="IdTemporada" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="NumeroHabitacionesTarifa" class="form-label"></label>
        <input asp-for="NumeroHabitacionesTarifa" class="form-control" type="number" min="1" max="2" />
        <span asp-validation-for="NumeroHabitacionesTarifa" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="PersonasIncluidas" class="form-label"></label>
        <input asp-for="PersonasIncluidas" class="form-control" type="number" min="1" />
        <span asp-validation-for="PersonasIncluidas" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="TarifaBase" class="form-label"></label>
        <input asp-for="TarifaBase" class="form-control" type="number" min="0" step="0.01" />
        <span asp-validation-for="TarifaBase" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="ValorPersonaAdicional" class="form-label"></label>
        <input asp-for="ValorPersonaAdicional" class="form-control" type="number" min="0" step="0.01" />
        <span asp-validation-for="ValorPersonaAdicional" class="text-danger"></span>
    </div>

    <div class="col-md-12">
        <label asp-for="Descripcion" class="form-label"></label>
        <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Descripcion" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <div class="form-check">
            <input asp-for="EsTarifaEspecial" class="form-check-input" />
            <label asp-for="EsTarifaEspecial" class="form-check-label"></label>
        </div>
    </div>

    <div class="col-md-6">
        <div class="form-check">
            <input asp-for="Activo" class="form-check-input" />
            <label asp-for="Activo" class="form-check-label"></label>
        </div>
    </div>
</div>
