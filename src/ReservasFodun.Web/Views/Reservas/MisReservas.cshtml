@model IEnumerable<ReservasFodun.Application.DTOs.Reservas.MisReservasDto>

@{
    ViewData["Title"] = "Mis reservas";
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
    <div>
        <h1 class="page-title">Mis reservas</h1>
        <p class="page-subtitle">Consulta el estado y detalle de tus reservas registradas.</p>
    </div>

    <a asp-controller="Reservas" asp-action="Confirmar" class="btn btn-primary">
        Crear nueva reserva
    </a>
</div>

@if (Model is null || !Model.Any())
{
    <div class="alert alert-info">
        No tienes reservas registradas actualmente.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Sede</th>
                    <th>Estado</th>
                    <th>Llegada</th>
                    <th>Salida</th>
                    <th>Personas</th>
                    <th>Habitaciones</th>
                    <th>Total</th>
                    <th>Fecha creación</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var reserva in Model)
                {
                    <tr>
                        <td>@reserva.IdReserva</td>
                        <td>@reserva.NombreSede</td>
                        <td>
                            <span class="badge bg-dark">
                                @reserva.EstadoReserva
                            </span>
                        </td>
                        <td>@reserva.FechaLlegada.ToString("dd/MM/yyyy")</td>
                        <td>@reserva.FechaSalida.ToString("dd/MM/yyyy")</td>
                        <td>@reserva.NumeroPersonas</td>
                        <td>@reserva.NumeroHabitaciones</td>
                        <td>@reserva.ValorTotal.ToString("C0")</td>
                        <td>@reserva.FechaCreacion.ToString("dd/MM/yyyy")</td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-2">
                                <a asp-controller="Reservas"
                                   asp-action="Detalle"
                                   asp-route-id="@reserva.IdReserva"
                                   class="btn btn-outline-primary btn-sm">
                                    Ver
                                </a>

                                @if (reserva.PermiteCancelar)
                                {
                                    <form asp-controller="Reservas" asp-action="Cancelar" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="IdReserva" value="@reserva.IdReserva" />
                                        <button type="submit" class="btn btn-primary btn-sm">
                                            Cancelar
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
