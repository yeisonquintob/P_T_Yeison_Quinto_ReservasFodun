@model ReservasFodun.Application.DTOs.Alojamientos.ConsultarDisponibilidadRequest

@{
    ViewData["Title"] = "Consultar disponibilidad";
    var sedes = ViewBag.Sedes as IEnumerable<ReservasFodun.Application.DTOs.Alojamientos.SedeDto>
        ?? Enumerable.Empty<ReservasFodun.Application.DTOs.Alojamientos.SedeDto>();
}

<div class="container py-4">
    <h2>Consultar disponibilidad</h2>
    <p class="text-muted">Selecciona una sede, fechas y número de personas para buscar alojamientos disponibles.</p>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Resultados" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label class="form-label">Sede</label>
                    <select class="form-select" asp-for="IdSede">
                        <option value="">Todas las sedes</option>
                        @foreach (var sede in sedes)
                        {
                            <option value="@sede.IdSede">@sede.NombreSede</option>
                        }
                    </select>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="FechaLlegada" class="form-label">Fecha llegada</label>
                        <input asp-for="FechaLlegada" type="date" class="form-control" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="FechaSalida" class="form-label">Fecha salida</label>
                        <input asp-for="FechaSalida" type="date" class="form-control" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="NumeroPersonas" class="form-label">Número de personas</label>
                        <input asp-for="NumeroPersonas" type="number" min="1" class="form-control" />
                    </div>
                </div>

                <button type="submit" class="btn btn-primary">
                    Buscar disponibilidad
                </button>
            </form>
        </div>
    </div>
</div>
