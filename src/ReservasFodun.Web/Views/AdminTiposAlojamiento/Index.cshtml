@model IEnumerable<ReservasFodun.Application.DTOs.Admin.TipoAlojamientoAdminDto>

@{
    ViewData["Title"] = "Tipos de alojamiento";
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
    <div>
        <h1 class="page-title">Tipos de alojamiento</h1>
        <p class="page-subtitle">Administra los tipos usados para clasificar habitaciones, apartamentos y alojamientos.</p>
    </div>

    <a asp-action="Crear" class="btn btn-primary">Crear tipo</a>
</div>

@if (Model is null || !Model.Any())
{
    <div class="alert alert-info">No hay tipos de alojamiento registrados.</div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>Alojamientos</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tipo in Model)
                {
                    <tr>
                        <td>@tipo.IdTipoAlojamiento</td>
                        <td><strong>@tipo.Nombre</strong></td>
                        <td>@(tipo.Descripcion ?? "No registrada")</td>
                        <td>@tipo.TotalAlojamientos</td>
                        <td>
                            @if (tipo.Activo)
                            {
                                <span class="badge bg-dark">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactivo</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-2">
                                <a asp-action="Detalle" asp-route-id="@tipo.IdTipoAlojamiento" class="btn btn-outline-primary btn-sm">Ver</a>
                                <a asp-action="Editar" asp-route-id="@tipo.IdTipoAlojamiento" class="btn btn-primary btn-sm">Editar</a>

                                @if (tipo.Activo)
                                {
                                    <form asp-action="Inactivar" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@tipo.IdTipoAlojamiento" />
                                        <button type="submit" class="btn btn-outline-secondary btn-sm"
                                                onclick="return confirm('¿Seguro que deseas inactivar este tipo de alojamiento?');">
                                            Inactivar
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="Activar" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@tipo.IdTipoAlojamiento" />
                                        <button type="submit" class="btn btn-outline-primary btn-sm"
                                                onclick="return confirm('¿Seguro que deseas activar este tipo de alojamiento?');">
                                            Activar
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
