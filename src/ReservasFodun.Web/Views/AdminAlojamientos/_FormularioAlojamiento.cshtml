@model ReservasFodun.Application.DTOs.Admin.AlojamientoFormularioRequest

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="IdSede" class="form-label"></label>
        <select asp-for="IdSede" asp-items="ViewBag.Sedes" class="form-select">
            <option value="">Seleccione...</option>
        </select>
        <span asp-validation-for="IdSede" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="IdTipoAlojamiento" class="form-label"></label>
        <select asp-for="IdTipoAlojamiento" asp-items="ViewBag.TiposAlojamiento" class="form-select">
            <option value="">Seleccione...</option>
        </select>
        <span asp-validation-for="IdTipoAlojamiento" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="NumeroAlojamiento" class="form-label"></label>
        <input asp-for="NumeroAlojamiento" class="form-control" />
        <span asp-validation-for="NumeroAlojamiento" class="text-danger"></span>
    </div>

    <div class="col-md-8">
        <label asp-for="NombreAlojamiento" class="form-label"></label>
        <input asp-for="NombreAlojamiento" class="form-control" />
        <span asp-validation-for="NombreAlojamiento" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="NumeroHabitaciones" class="form-label"></label>
        <input asp-for="NumeroHabitaciones" class="form-control" type="number" min="1" />
        <span asp-validation-for="NumeroHabitaciones" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="CapacidadMaxima" class="form-label"></label>
        <input asp-for="CapacidadMaxima" class="form-control" type="number" min="1" />
        <span asp-validation-for="CapacidadMaxima" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="NumeroHabitacionesTarifa" class="form-label"></label>
        <input asp-for="NumeroHabitacionesTarifa" class="form-control" type="number" min="1" />
        <span asp-validation-for="NumeroHabitacionesTarifa" class="text-danger"></span>
    </div>

    <div class="col-md-12">
        <label asp-for="Descripcion" class="form-label"></label>
        <textarea asp-for="Descripcion" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Descripcion" class="text-danger"></span>
    </div>

    <div class="col-md-12">
        <div class="form-check">
            <input asp-for="Activo" class="form-check-input" />
            <label asp-for="Activo" class="form-check-label"></label>
        </div>
    </div>
</div>
