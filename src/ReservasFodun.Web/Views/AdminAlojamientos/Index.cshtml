@model IEnumerable<ReservasFodun.Application.DTOs.Admin.AlojamientoAdminDto>

@{
    ViewData["Title"] = "Administrar alojamientos";
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
    <div>
        <h1 class="page-title">Administrar alojamientos</h1>
        <p class="page-subtitle">Gestiona habitaciones, apartamentos y alojamientos asociados a las sedes.</p>
    </div>

    <a asp-action="Crear" class="btn btn-primary">
        Crear alojamiento
    </a>
</div>

@if (Model is null || !Model.Any())
{
    <div class="alert alert-info">
        No hay alojamientos registrados.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Sede</th>
                    <th>Número</th>
                    <th>Nombre</th>
                    <th>Tipo</th>
                    <th>Habitaciones</th>
                    <th>Capacidad</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var alojamiento in Model)
                {
                    <tr>
                        <td>@alojamiento.IdAlojamiento</td>
                        <td>@alojamiento.NombreSede</td>
                        <td>@alojamiento.NumeroAlojamiento</td>
                        <td>
                            <strong>@alojamiento.NombreAlojamiento</strong>
                        </td>
                        <td>@alojamiento.TipoAlojamiento</td>
                        <td>@alojamiento.NumeroHabitaciones</td>
                        <td>@alojamiento.CapacidadMaxima</td>
                        <td>
                            @if (alojamiento.Activo)
                            {
                                <span class="badge bg-dark">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactivo</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-2">
                                <a asp-action="Detalle" asp-route-id="@alojamiento.IdAlojamiento" class="btn btn-outline-primary btn-sm">
                                    Ver
                                </a>

                                <a asp-action="Editar" asp-route-id="@alojamiento.IdAlojamiento" class="btn btn-primary btn-sm">
                                    Editar
                                </a>

                                @if (alojamiento.Activo)
                                {
                                    <form asp-action="Inactivar" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@alojamiento.IdAlojamiento" />
                                        <button type="submit" class="btn btn-outline-secondary btn-sm"
                                                onclick="return confirm('¿Seguro que deseas inactivar este alojamiento?');">
                                            Inactivar
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="Activar" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@alojamiento.IdAlojamiento" />
                                        <button type="submit" class="btn btn-outline-primary btn-sm"
                                                onclick="return confirm('¿Seguro que deseas activar este alojamiento?');">
                                            Activar
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
