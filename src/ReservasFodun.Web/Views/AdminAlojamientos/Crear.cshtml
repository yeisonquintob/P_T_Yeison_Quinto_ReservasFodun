@model ReservasFodun.Application.DTOs.Admin.AlojamientoFormularioRequest

@{
    ViewData["Title"] = "Crear alojamiento";
}

<div class="mb-4">
    <h1 class="page-title">Crear alojamiento</h1>
    <p class="page-subtitle">Registra un nuevo alojamiento asociado a una sede.</p>
</div>

<div class="section-card">
    <form asp-action="Crear" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <partial name="_FormularioAlojamiento" model="Model" />

        <div class="d-flex flex-wrap gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Guardar alojamiento</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
