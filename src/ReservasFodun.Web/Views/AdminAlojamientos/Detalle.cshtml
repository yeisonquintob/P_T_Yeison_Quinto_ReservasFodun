@model ReservasFodun.Application.DTOs.Admin.AlojamientoAdminDto

@{
    ViewData["Title"] = "Detalle alojamiento";
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
    <div>
        <h1 class="page-title">@Model.NombreAlojamiento</h1>
        <p class="page-subtitle">Detalle administrativo del alojamiento.</p>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Editar" asp-route-id="@Model.IdAlojamiento" class="btn btn-primary">Editar</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
    </div>
</div>

<div class="section-card">
    <div class="row g-4">
        <div class="col-md-6">
            <h5>Información general</h5>

            <dl class="row mb-0">
                <dt class="col-sm-5">Código</dt>
                <dd class="col-sm-7">@Model.IdAlojamiento</dd>

                <dt class="col-sm-5">Sede</dt>
                <dd class="col-sm-7">@(Model.NombreSede ?? "No registrada")</dd>

                <dt class="col-sm-5">Tipo</dt>
                <dd class="col-sm-7">@(Model.TipoAlojamiento ?? "No registrado")</dd>

                <dt class="col-sm-5">Número</dt>
                <dd class="col-sm-7">@Model.NumeroAlojamiento</dd>

                <dt class="col-sm-5">Estado</dt>
                <dd class="col-sm-7">
                    @if (Model.Activo)
                    {
                        <span class="badge bg-dark">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactivo</span>
                    }
                </dd>
            </dl>
        </div>

        <div class="col-md-6">
            <h5>Capacidad</h5>

            <dl class="row mb-0">
                <dt class="col-sm-6">Habitaciones</dt>
                <dd class="col-sm-6">@Model.NumeroHabitaciones</dd>

                <dt class="col-sm-6">Capacidad máxima</dt>
                <dd class="col-sm-6">@Model.CapacidadMaxima</dd>

                <dt class="col-sm-6">Habitaciones tarifa</dt>
                <dd class="col-sm-6">@(Model.NumeroHabitacionesTarifa?.ToString() ?? "No aplica")</dd>
            </dl>
        </div>

        <div class="col-12">
            <h5>Descripción</h5>
            <p class="text-muted mb-0">
                @(string.IsNullOrWhiteSpace(Model.Descripcion) ? "No se registró descripción." : Model.Descripcion)
            </p>
        </div>
    </div>
</div>
